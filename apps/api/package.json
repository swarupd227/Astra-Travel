{
  "name": "@astra/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Astra Travel platform API (REST, OpenAPI 3.1)",
  "scripts": {
    "dev": "node --env-file=../../.env --watch --import tsx src/main.ts",
