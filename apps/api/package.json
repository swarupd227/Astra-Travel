  "dependencies": {
    "@astra/agents": "0.1.0",
    "@astra/card": "0.1.0",
    "@astra/contracts": "0.1.0",
    "@astra/documents": "0.1.0",
    "@astra/platform": "0.1.0",
    "@astra/plans": "0.1.0",
    "@astra/policies": "0.1.0",
    "@astra/rating": "0.1.0",
    "@astra/studio": "0.1.0",
    "@astra/underwriting": "0.1.0",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.5",
    "@fastify/swagger-ui": "6.1.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.18",
    "zod": "4.6.7"
