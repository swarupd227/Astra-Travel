{
  "uid": "astra-service-health",
  "title": "Astra Travel - Service health",
  "description": "Availability and latency of the platform APIs (E13-F03-S01), event delivery and integrations. Quote, bind and cover verification routes appear as they ship; filter with the Route variable.",
  "tags": ["astra", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(astra_api_request_duration_seconds_count, http_route)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API availability (non-5xx), selected window",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 3, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.999 }, { "color": "green", "value": 0.9995 } ] } } },
      "targets": [
        { "refId": "A", "expr": "1 - (sum(increase(astra_api_request_duration_seconds_count{http_route=~\"$route\", http_response_status_code=~\"5..\"}[$__range])) or vector(0)) / clamp_min(sum(increase(astra_api_request_duration_seconds_count{http_route=~\"$route\"}[$__range])), 1)" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p95 latency",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.4 }, { "color": "red", "value": 0.5 } ] } } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(astra_api_request_duration_seconds_bucket{http_route=~\"$route\"}[5m])))" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Dead-lettered deliveries (window)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [ { "refId": "A", "expr": "sum(increase(astra_events_deliveries_dead_lettered_total[$__range])) or vector(0)" } ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests per second",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [ { "refId": "A", "expr": "sum(rate(astra_api_request_duration_seconds_count{http_route=~\"$route\"}[5m]))" } ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latency by route (p50 / p95 / p99)",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "legendFormat": "p95 {{http_route}}", "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(astra_api_request_duration_seconds_bucket{http_route=~\"$route\"}[5m])))" },
        { "refId": "B", "legendFormat": "p99 {{http_route}}", "expr": "histogram_quantile(0.99, sum by (le, http_route) (rate(astra_api_request_duration_seconds_bucket{http_route=~\"$route\"}[5m])))" },
        { "refId": "C", "legendFormat": "p50 {{http_route}}", "expr": "histogram_quantile(0.50, sum by (le, http_route) (rate(astra_api_request_duration_seconds_bucket{http_route=~\"$route\"}[5m])))" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Responses by status class",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{http_response_status_code}}", "expr": "sum by (http_response_status_code) (rate(astra_api_request_duration_seconds_count{http_route=~\"$route\"}[5m]))" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Event delivery outcomes",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "relayed", "expr": "sum(rate(astra_events_relayed_total[5m]))" },
        { "refId": "B", "legendFormat": "delivered", "expr": "sum(rate(astra_events_deliveries_succeeded_total[5m]))" },
        { "refId": "C", "legendFormat": "failed (retrying)", "expr": "sum(rate(astra_events_deliveries_failed_total[5m]))" },
        { "refId": "D", "legendFormat": "dead-lettered", "expr": "sum(rate(astra_events_deliveries_dead_lettered_total[5m]))" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Outbound integration calls by outcome",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "{{integration}} {{outcome}}", "expr": "sum by (integration, outcome) (rate(astra_integration_calls_total[5m]))" }
      ]
    }
  ]
}
