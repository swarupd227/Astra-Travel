{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["-w", "@astra/api", "run", "serve"],
      "port": 4000
    },
    {
      "name": "worker",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["-w", "@astra/worker", "run", "serve"],
      "port": 4100
    },
    {
      "name": "workbench",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:workbench"],
      "port": 3000
    }
  ]
}
