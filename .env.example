# Astra Travel local environment.
# Run `node scripts/init-env.mjs` to create .env with freshly generated local-only secrets.
# Values marked __GENERATE__ are replaced with random values. Never commit .env.

# --- PostgreSQL (docker compose, host port 5433) ---
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
ASTRA_DB_OWNER_PASSWORD=__GENERATE__
ASTRA_DB_APP_PASSWORD=__GENERATE__
KEYCLOAK_DB_PASSWORD=__GENERATE__
DATABASE_URL=postgres://astra_app:${ASTRA_DB_APP_PASSWORD}@localhost:5433/astra
DATABASE_OWNER_URL=postgres://astra_owner:${ASTRA_DB_OWNER_PASSWORD}@localhost:5433/astra
TEST_DATABASE_URL=postgres://astra_app:${ASTRA_DB_APP_PASSWORD}@localhost:5433/astra_test
TEST_DATABASE_OWNER_URL=postgres://astra_owner:${ASTRA_DB_OWNER_PASSWORD}@localhost:5433/astra_test

# --- Identity (Keycloak locally; Microsoft Entra ID in Azure) ---
KEYCLOAK_ADMIN_PASSWORD=__GENERATE__
OIDC_ISSUER=http://localhost:8080/realms/astra
OIDC_AUDIENCE=astra-api
# Optional JSON map of IdP group name or object ID -> Astra role, e.g. Entra group GUIDs.
# OIDC_GROUP_ROLE_MAP={"6f1c...":"platform_admin"}
WORKBENCH_CLIENT_ID=astra-workbench
WORKBENCH_CLIENT_SECRET=__GENERATE__
# Local-only password shared by the synthetic staff users in the local realm (see docs/LOCAL_DEVELOPMENT.md).
DEV_USER_PASSWORD=__GENERATE__
# Sandbox partner clients (client credentials grant), one per synthetic account.
PARTNER_A_CLIENT_SECRET=__GENERATE__
PARTNER_B_CLIENT_SECRET=__GENERATE__

# --- Secrets encryption (Azure Key Vault key in cloud) ---
SECRETS_KEK_ID=local-1
SECRETS_KEK=__GENERATE_BASE64_32__

# --- Services ---
API_PORT=4000
API_BASE_URL=http://localhost:4000
WORKBENCH_BASE_URL=http://localhost:3000
WORKBENCH_SESSION_SECRET=__GENERATE__
LOG_LEVEL=info

# --- Observability (OpenTelemetry -> Grafana LGTM locally; Azure Monitor in cloud) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SEMCONV_STABILITY_OPT_IN=http
GRAFANA_ADMIN_PASSWORD=__GENERATE__
